# Copy to hosts.ini and replace the placeholders.
[openshelf]
openshelf-demo-node ansible_connection=amazon.aws.aws_ssm ansible_aws_ssm_instance_id=REPLACE_WITH_INSTANCE_ID ansible_aws_ssm_region=ap-south-1 ansible_aws_ssm_profile=openshelf-admin ansible_aws_ssm_bucket_name=REPLACE_WITH_SSM_TRANSFER_BUCKET ansible_aws_ssm_bucket_sse_mode=AES256 ansible_python_interpreter=/usr/bin/python3

[openshelf:vars]
ansible_become=true
ansible_become_method=sudo
ansible_become_user=root
