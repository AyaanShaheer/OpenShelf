# OpenShelf example configuration (placeholders only)

# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (authoritative datastore)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openshelf
DB_USER=openshelf
DB_PASSWORD=change-me

# Solr (search/index)
SOLR_BASE_URL=http://localhost:8983/solr
SOLR_COLLECTION=openshelf

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dev-only bootstrap admin (optional; used only when explicitly enabled/configured)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

# Upload limits
MAX_UPLOAD_SIZE_MB=10

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
